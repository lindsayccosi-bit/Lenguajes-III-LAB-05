package act4;

class ExcepcionPilaLlena extends RuntimeException {
    public ExcepcionPilaLlena(String mensaje) {
        super(mensaje);
    }
}


//Clase de excepción cuando la pila está vacía
class ExcepcionPilaVacia extends RuntimeException {
 public ExcepcionPilaVacia(String mensaje) {
     super(mensaje);
 }
}

package act4;

public class Pila<E> {
    private final int tamanio; // número de elementos en la pila
    private int superior;      // ubicación del elemento superior
    private E[] elementos;     // arreglo que almacena los elementos de la pila

    public Pila() {
        this(10);
    }

    public Pila(int s) {
        tamanio = s > 0 ? s : 10;
        superior = -1;
        elementos = (E[]) new Object[tamanio];
    }

    public void push(E valorAMeter) {
        if (superior == tamanio - 1)
            throw new ExcepcionPilaLlena(String.format(
                "La pila está llena, no se puede meter %s", valorAMeter));

        elementos[++superior] = valorAMeter;
    }

    public E pop() {
        if (superior == -1)
            throw new ExcepcionPilaVacia("La pila está vacía, no se puede sacar");
        return elementos[superior--];
    }

    //  Método genérico para comparar dos pilas
    public boolean esIgual(Pila<E> otraPila) {
        // Si se tiene diferente cantidad de elementos, no son iguales
        if (this.superior != otraPila.superior) {
            return false;
        }

        // Se compara elemento por elemento
        for (int i = 0; i <= this.superior; i++) {
            E elem1 = this.elementos[i];
            E elem2 = otraPila.elementos[i];

            if (elem1 == null && elem2 == null) {
                continue; // ambos nulos son iguales
            }
            if (elem1 == null || !elem1.equals(elem2)) {
                return false; // diferentes
            }
        }
        return true; // si todos coinciden
    }
}


package act4;

public class PruebaPila {
    public static void main(String[] args) {
        // Crear dos pilas de enteros
        Pila<Integer> pila1 = new Pila<>(5);
        Pila<Integer> pila2 = new Pila<>(5);

        // Agrega los mismos elementos
        pila1.push(10);
        pila1.push(20);
        pila1.push(30);

        pila2.push(10);
        pila2.push(20);
        pila2.push(30);

        // Compara
        System.out.println("¿pila1 es igual a pila2? " + pila1.esIgual(pila2));

        // Modifica una pila
        pila2.pop();   // elimina el 30
        pila2.push(40);

        // Compara nuevamente
        System.out.println("¿pila1 es igual a pila2? " + pila1.esIgual(pila2));

        // Prueba con pilas vacías
        Pila<String> pila3 = new Pila<>(3);
        Pila<String> pila4 = new Pila<>(3);
        System.out.println("¿pila3 es igual a pila4? " + pila3.esIgual(pila4));
    }
}
